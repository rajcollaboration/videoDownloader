NEXT_PUBLIC_APP_URL=http://localhost
# Used for SSR only; the browser resolves /api from the current host (works on :3000 and :80).
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_GA_MEASUREMENT_ID=

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/video_downloader
REDIS_URL=redis://redis:6379/0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
STORAGE_MODE=local
LOCAL_STORAGE_PATH=/app/storage
RATE_LIMIT_PER_MINUTE=20
MAX_PLAYLIST_SIZE=1000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost
ENABLE_YOUTUBE=false
ADMIN_API_KEY=change-me-admin-key

# yt-dlp tuning (optional)
# Increase for faster DASH/HLS downloads (more parallel fragment fetching).
YTDLP_CONCURRENT_FRAGMENTS=4
# Optional: use an external downloader like aria2c if installed in the container/host.
# YTDLP_EXTERNAL_DOWNLOADER=aria2c
# YTDLP_EXTERNAL_DOWNLOADER_ARGS=-x 16 -s 16 -k 1M
# Optional: enables ranged requests for some servers/CDNs.
# YTDLP_HTTP_CHUNK_SIZE=10485760

POSTGRES_DB=video_downloader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Celery worker concurrency — number of playlist items downloaded in
# parallel per worker container. Scale up for heavier machines.
CELERY_CONCURRENCY=4

