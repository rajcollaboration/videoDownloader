# Copy to .env on your production server:
#   cp .env.production.example .env
# Then replace every CHANGE-ME value before deploying.

DOMAIN=clipzyworld.online
CERTBOT_EMAIL=admin@clipzyworld.online
NGINX_CONF=production.conf

NEXT_PUBLIC_APP_URL=https://clipzyworld.online
NEXT_PUBLIC_API_BASE_URL=https://clipzyworld.online/api
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_GA_MEASUREMENT_ID=

APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=CHANGE-ME-long-random-secret
ADMIN_API_KEY=CHANGE-ME-long-random-admin-key

DATABASE_URL=postgresql+psycopg://postgres:CHANGE-ME-db-password@postgres:5432/video_downloader
REDIS_URL=redis://redis:6379/0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
STORAGE_MODE=local
LOCAL_STORAGE_PATH=/app/storage
RATE_LIMIT_PER_MINUTE=20
MAX_PLAYLIST_SIZE=1000
ALLOWED_ORIGINS=https://clipzyworld.online,https://www.clipzyworld.online
ENABLE_YOUTUBE=false

POSTGRES_DB=video_downloader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-db-password

CELERY_CONCURRENCY=4
